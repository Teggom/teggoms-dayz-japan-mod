{
 "id": "jp_s_grave_stones",
 "build_list": {
  "name": "Graveyard stones: the 1730 mix (board-shaped, boat-halo, round-headed, square pillar, gorinto, hokyointo)",
  "importance": "standard",
  "tiers": [
   1,
   2,
   3
  ],
  "abandoned_state": "Graves are the one place that looks almost as before: lichen and moss heavier, some stones leaning, gorinto top rings fallen; weeds between plots.",
  "placement_rule": "Behind or beside temples on slopes, in rows facing the path; family graves at field edges in the Kanto (2-6 stones); single traveller graves by roads.",
  "lod_budget": "small prop <=300 faces LOD0 per stone",
  "dimensions": {
   "board_shaped_m": {
    "value": "0.6-0.9 high x 0.30 x 0.15, pointed-arch top, on 1-2 bases",
    "assumed": true,
    "reason": "O05 gives the dating, not sizes; sizes assumed from surveyed examples"
   },
   "boat_halo_m": {
    "value": "0.5-0.9 high, figure in relief",
    "source": "O06 (form, dating); size assumed"
   },
   "round_headed_m": {
    "value": "0.6-0.9 high x 0.30 x 0.20 (kushigata)",
    "assumed": true,
    "reason": "assumed"
   },
   "square_pillar_m": {
    "value": "0.6-0.9 shaft + 2-3 bases 0.15 each",
    "assumed": true,
    "reason": "rising, rare in 1730 (OUTDOOR_LIST §3.3)"
   },
   "gorinto_m": {
    "value": "0.6 (commoner) to 2.0 (samurai)",
    "assumed": true,
    "reason": "assumed"
   },
   "mix_1730": {
    "value": "board 35 %, boat-halo 30 %, round-headed 20 %, square pillar 5 %, gorinto / hokyointo 10 %",
    "source": "O05, O06, OUTDOOR_LIST §3.3 (reading)"
   }
  },
  "refs": [
   {
    "id": "c24_jizo_cemetery",
    "shows": "Jizo and gravestones, weathered stone",
    "period_image": false
   },
   {
    "id": "k25_gorinto",
    "shows": "gorinto five-ring stupa (photo)",
    "period_image": false
   },
   {
    "id": "k26_gorinto_gamou",
    "shows": "large gorinto grave (photo)",
    "period_image": false
   }
  ]
 },
 "group": "grave",
 "frame": "origin = base centre on the terrain, +y up, +z = front (road side), autocenter=0; anchor 'wall': the wall plane is z = 0, the object stands wall_gap in front (+z), y = 0 at the wall foot",
 "notes": [
  "1730 mix for the placement agent (W2_ERA): board 30 %, boat-halo 25 %, round 12 %, field stones / mounds 15 %, child Jizo 5 %, square pillar 5 %, gorinto / hokyointo 8 %",
  "irregular rows: 0.9 m plot grid jittered +-0.15 m and +-12 deg, mixed heights, gaps",
  "inscriptions (M1): a posthumous name and date per stone from jp_m_decal_carved_text_grave (1670-1729: -shinji / -shinnyo, -zenjomon / -zenjoni, -doji, shaku-, kigen / enjaku prefixes) + B1's two; no family-name stones (Meiji)",
  "seed syllables (M2, W2_ERA G16-G18): gorinto rings kha / ha / ra / va / a on the front (small, large, re-stacked, fallen; the fragment heap blank); hokyointo body hum (front, east) / trah (+x, south) / hrih (back, west) / ah (-x, north); Noto Sans Siddham (SIL OFL 1.1)",
  "abandoned share: about 1 stone in 4 leaning / sunk / broken"
 ],
