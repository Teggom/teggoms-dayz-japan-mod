{
 "id": "jp_s_well_tsurube",
 "build_list": {
  "name": "Pulley well (tsurube-ido): curb, frame, pulley, two buckets; roofed variant",
  "importance": "standard",
  "tiers": [
   1,
   2,
   3
  ],
  "abandoned_state": "Frames stand; the rope has rotted and one bucket sits on the curb; lids are askew or gone; the wash slab is silted with leaves. Water is still there (decision 3).",
  "placement_rule": "Yards: 3-8 m behind the house, near the kitchen door; towns: in the back-alley court (one per nagaya court); never in the street itself.",
  "lod_budget": "medium site object <=1,500 faces LOD0 (decision 9)",
  "dimensions": {
   "shaft_diameter_m": {
    "value": "0.9-1.0 inside",
    "source": "O22"
   },
   "curb_m": {
    "value": "outside d 1.05-1.20 (round tub curb) or 1.20 x 1.20 (square igeta), h 0.60-0.75",
    "assumed": true,
    "reason": "shaft plus a 0.08-0.10 wall; height from Morse figs 287-288 (k13, k14) read against a figure"
   },
   "frame_height_m": {
    "value": "2.2-2.4 to the pulley axle",
    "assumed": true,
    "reason": "read off Morse fig 289 (k10); keeps the rope clear of a standing head"
   },
   "bucket_m": {
    "value": "d 0.26 x h 0.28 with an iron band (tsurube-oke)",
    "source": "O23 (iron fittings); size assumed"
   },
   "roof_m": {
    "value": "small gable, 1.6 x 1.8 plan, eave 2.1, board or shingle (roofed variant)",
    "assumed": true,
    "reason": "Morse fig 293 (k12); matches dwelling shell 28"
   }
  },
  "refs": [
   {
    "id": "k10_morse_well_frame",
    "shows": "wooden well-frame with pulley (Morse 1885)",
    "period_image": false
   },
   {
    "id": "k12_morse_well_kaga",
    "shows": "well at the Kaga yashiki, Tokyo: roofed frame (Morse 1885)",
    "period_image": false
   },
   {
    "id": "k14_morse_well_curb_stone",
    "shows": "stone well-curb (Morse 1885)",
    "period_image": false
   },
   {
    "id": "k13_morse_well_curb_old",
    "shows": "ancient form of wooden well-curb, igeta (Morse 1885)",
    "period_image": false
   },
   {
    "id": "k32_harunobu_well",
    "shows": "pulley well, buckets and a tub, Suzuki Harunobu (d. 1770), 1760s",
    "period_image": true
   }
  ]
 },
