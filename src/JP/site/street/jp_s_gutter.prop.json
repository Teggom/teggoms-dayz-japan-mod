{
 "id": "jp_s_gutter",
 "build_list": {
  "name": "Street gutter kit (omote-dobu): stone-lined segment, slab crossing, dobu-ita cover, outfall",
  "importance": "standard",
  "tiers": [
   2,
   3
  ],
  "abandoned_state": "Silted to half depth with leaves and mud; weeds along the joints; a few dobu-ita boards gone or snapped so the drain gapes.",
  "placement_rule": "Continuous along every town street front, 0.3 m outside the house line, a slab at each door; down the centre of back alleys with boards; highway ditches are terrain only.",
  "lod_budget": "small prop <=300 faces LOD0 per piece; Geometry only on slabs and boards (the channel stays walkable), Roadway on slabs and boards",
  "dimensions": {
   "segment_length_m": {
    "value": "1.82 (1 ken) and 0.91 pieces",
    "assumed": true,
    "reason": "snaps to the house grid (PLAYBOOK rule 9) so every front gets whole pieces"
   },
   "channel_m": {
    "value": "omote-dobu inside 0.30 wide x 0.25-0.30 deep; alley dobu 0.20 x 0.20",
    "assumed": true,
    "reason": "O24 gives 3-6 shaku for the big lot-boundary drains; the street-front gutter is narrower (step-over width); assumed"
   },
   "lining_m": {
    "value": "dressed stones 0.15-0.20 thick, top flush with grade",
    "assumed": true,
    "reason": "assumed"
   },
   "slab_crossing_m": {
    "value": "granite slab 0.60-0.90 x 0.45 x 0.12 bridging the gutter at each door",
    "assumed": true,
    "reason": "assumed"
   },
   "dobu_ita_m": {
    "value": "boards 0.91 long x 0.24-0.30 wide x 0.03, laid across",
    "assumed": true,
    "reason": "assumed; boards rattle (noise hook)"
   }
  },
  "refs": [
   {
    "id": "x38_morse_gutter",
    "shows": "bamboo eave gutter and downpipe feeding a street drain (Morse 1885)",
    "period_image": false
   },
   {
    "id": "x27_morse_village_yamashiro",
    "shows": "Kansai village street with a stone-edged drain (Morse 1885)",
    "period_image": false
   },
   {
    "id": "c01_narai_street",
    "shows": "post-town street edge with a gutter (surviving street)",
    "period_image": false
   }
  ]
 },
