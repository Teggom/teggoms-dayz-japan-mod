  "name": "Shop-front kit: noren, mizuhiki-noren, sudare, hanging and standing signboards, shape signs",
  "importance": "standard",
  "tiers": [
   2,
   3
  ],
  "abandoned_state": "Cloth goes first: noren faded from indigo to grey-blue and shredded, some fallen with their poles; sudare slumped and holed; signboards hanging askew from one cord, text bleached.",
  "placement_rule": "Noren only on open shop and eating-house doors (not on houses or kura); one sign type per shop; shape signs only on the matching trade (KEEP_TRADES dressing sets).",
  "lod_budget": "small prop <=300 faces LOD0 per piece; noren as 3 slightly bent quads per panel, two-sided",
  "dimensions": {
   "noren_m": {
    "value": "3 panels x 0.34 = 1.02 wide per door; long 1.60, standard 1.13, half 0.56",
    "source": "O19 (modern trade sizes on the old kujira shaku; panel width 1 haba)"
   },
   "mizuhiki_m": {
    "value": "0.30-0.40 deep, full front width, unsplit",
    "source": "O19"
   },
   "sudare_m": {
    "value": "0.91 or 1.82 wide x 0.9-1.8 long, rolled d 0.10-0.12 when up",
    "assumed": true,
    "reason": "on the half-ken grid; assumed"
   },
   "kake_kanban_m": {
    "value": "0.9-1.5 long x 0.25-0.35 x 0.04, hung under the eave",
    "assumed": true,
    "reason": "assumed from prints"
   },
   "oki_kanban_m": {
    "value": "0.45 x 1.2 high on feet",
    "assumed": true,
    "reason": "assumed"
   },
   "shape_signs": {
    "value": "6: giant brush 1.2, geta 0.6, tabi 0.7, medicine gourd 0.6, umbrella 1.0, fan 0.8",
    "assumed": true,
    "reason": "OUTDOOR_LIST §7.13 picks; sizes assumed"
   }
  },
