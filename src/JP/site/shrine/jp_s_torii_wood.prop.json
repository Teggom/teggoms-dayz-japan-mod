{
 "id": "jp_s_torii_wood",
 "build_list": {
  "name": "Wooden torii (ki-no-torii): shinmei and myojin forms, plain or vermilion",
  "importance": "standard",
  "tiers": [
   1,
   2,
   3
  ],
  "abandoned_state": "Wood torii weather fast: vermilion peeled in patches, the plain ones silver-grey with moss on the kasagi; one in five leans on a rotted post.",
  "placement_rule": "At the start of a shrine approach, square to the path; vermilion only at Inari and Hachiman shrines; mini torii only before a yard shrine.",
  "lod_budget": "medium site object <=1,500 faces LOD0 (decision 9); kasagi curve and silhouette in every LOD",
  "dimensions": {
   "village_m": {
    "value": "post span 1.8-2.7 (1-1.5 ken), height 2.7-3.6, post d 0.20-0.25",
    "source": "O11, O12 (stone torii of the same village class: 1.82 span x 2.71 h; 2.5 x 2.8)"
   },
   "mini_m": {
    "value": "span 0.6, height 0.9 (yard shrine)",
    "assumed": true,
    "reason": "assumed"
   },
   "kasagi_overhang_m": {
    "value": "0.35-0.50 past each post",
    "assumed": true,
    "reason": "assumed from proportion drawings"
   },
   "grid": {
    "value": "span in half-ken steps so the sando kit lines up",
    "assumed": true,
    "reason": "PLAYBOOK rule 9"
   }
  },
  "refs": [
   {
    "id": "k27_hida_torii",
    "shows": "unpainted wooden torii (photo)",
    "period_image": false
   },
   {
    "id": "c10_inari_torii",
    "shows": "shu vermilion and sumi black on torii",
    "period_image": false
   },
   {
    "id": "k02_bunken_ezu_p12",
    "shows": "roadside shrine torii marks on the 1690 Tokaido map",
    "period_image": true
   }
  ]
 },
 "group": "shrine",
 "frame": "origin = base centre on the terrain, +y up, +z = front (road side), autocenter=0; anchor 'wall': the wall plane is z = 0, the object stands wall_gap in front (+z), y = 0 at the wall foot",
 "notes": [
  "vermilion (_myojin_shu*, _mini_shu) ONLY at Inari and Hachiman shrines; mini torii only before a yard shrine (mount 'yard')",
  "rope variants carry the straw rope on the tie-beam; '_shide' adds 4-step zigzag paper streamers (W2_ERA T1-T3)",
  "mossy variants for rural shrines (W2_ERA T5)",
  "a village shrine gets a wooden or a stone torii, not both"
 ],
