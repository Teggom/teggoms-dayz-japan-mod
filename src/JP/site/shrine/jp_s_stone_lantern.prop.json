   "kasuga_proportion": {
    "value": "of total height: hoju 0.20, kasa 0.13, hibukuro 0.17, chudai 0.10, sao 0.36, kiso 0.05",
    "source": "O10"
   },
   "heights_m": {
    "value": "1.8 (6 shaku), 2.4 (8 shaku), 3.0 (10 shaku)",
    "assumed": true,
    "reason": "standard mason sizes by the shaku; the 3 heights of OUTDOOR_LIST §7.7"
   },
   "square_m": {
    "value": "square standing lantern 1.8-2.4, square fire box",
    "assumed": true,
    "reason": "OUTDOOR_LIST §2 U (assumed common Edo form)"
