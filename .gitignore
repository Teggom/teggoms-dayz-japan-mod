buildings/townhouse/out/
buildings/posttown/out/
buildings/hatago/out/
spikes/C1/renders/
spikes/C1/_*
# W2C: MLOD sources in out/ are regenerated by buildings/pipeline.py (the ODOLs in src are tracked)
buildings/teahouse/out/
buildings/smithy/out/
buildings/guardhut/out/
buildings/kido/out/
spikes/W2C/renders/
